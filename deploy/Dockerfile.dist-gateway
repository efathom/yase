FROM golang:1.26-alpine AS builder
RUN apk add --no-cache git
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /dist-gateway ./cmd/dist-gateway

FROM alpine:3.21
RUN apk add --no-cache ca-certificates \
    && addgroup -S -g 10001 yase && adduser -S -D -H -u 10001 -G yase yase
COPY --from=builder /dist-gateway /usr/local/bin/dist-gateway
EXPOSE 8000
USER 10001:10001
ENTRYPOINT ["dist-gateway"]
