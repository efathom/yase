FROM golang:1.26-alpine AS builder

RUN apk add --no-cache git

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /bin/ingestion ./cmd/ingestion

FROM alpine:3.21
RUN apk add --no-cache ca-certificates
RUN addgroup -S -g 10001 yase && adduser -S -D -H -u 10001 -G yase yase \
    && mkdir -p /data/yase && chown -R 10001:10001 /data/yase
COPY --from=builder /bin/ingestion /usr/local/bin/ingestion
COPY configs/default.yaml /etc/yase/config.yaml

EXPOSE 50051 9090
USER 10001:10001
ENTRYPOINT ["ingestion", "-config", "/etc/yase/config.yaml"]
