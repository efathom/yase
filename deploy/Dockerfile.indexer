FROM golang:1.26-alpine AS builder

RUN apk add --no-cache git

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /bin/indexer ./cmd/indexer

FROM alpine:3.21
RUN apk add --no-cache ca-certificates
COPY --from=builder /bin/indexer /usr/local/bin/indexer
COPY configs/default.yaml /etc/yase/config.yaml

EXPOSE 50052 9090
ENTRYPOINT ["indexer", "-config", "/etc/yase/config.yaml"]
