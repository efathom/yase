{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Search Latency P50/P99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(yase_gateway_search_duration_seconds_bucket[5m]))",
          "legendFormat": "P50"
        },
        {
          "expr": "histogram_quantile(0.99, rate(yase_gateway_search_duration_seconds_bucket[5m]))",
          "legendFormat": "P99"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "title": "Search Results per Query",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(yase_gateway_search_results_count_bucket[5m]))",
          "legendFormat": "P50 results"
        }
      ]
    },
    {
      "title": "Crawl Rate (URLs/sec)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(yase_crawler_urls_fetched_total[5m]))",
          "legendFormat": "URLs/sec"
        }
      ]
    },
    {
      "title": "Active Crawler Goroutines",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 8 },
      "targets": [
        {
          "expr": "yase_crawler_active_goroutines",
          "legendFormat": "goroutines"
        }
      ]
    },
    {
      "title": "Ingestion Throughput (docs/sec)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(yase_ingestion_documents_total[5m]))",
          "legendFormat": "docs/sec"
        }
      ]
    },
    {
      "title": "Worker Pool Queue Depth",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 8 },
      "targets": [
        {
          "expr": "yase_ingestion_queue_depth",
          "legendFormat": "queue"
        }
      ]
    },
    {
      "title": "Kafka Consumer Lag",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "yase_kafka_consumer_lag",
          "legendFormat": "{{topic}} p{{partition}}"
        }
      ]
    },
    {
      "title": "Kafka Messages Consumed",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "sum(rate(yase_kafka_messages_consumed_total[5m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "title": "HNSW Node Count",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "yase_hnsw_nodes_total",
          "legendFormat": "nodes"
        }
      ]
    },
    {
      "title": "HNSW Search Latency",
      "type": "timeseries",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 20 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(yase_hnsw_search_duration_seconds_bucket[5m]))",
          "legendFormat": "P99"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "title": "Arena Memory Used",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 20 },
      "targets": [
        {
          "expr": "yase_memory_arena_used_bytes / yase_memory_arena_capacity_bytes * 100",
          "legendFormat": "% used"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "max": 100 }
      }
    },
    {
      "title": "Arena Capacity",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 20 },
      "targets": [
        {
          "expr": "yase_memory_arena_capacity_bytes",
          "legendFormat": "bytes"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      }
    },
    {
      "title": "HTTP Fetch Duration by Domain",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(yase_crawler_fetch_duration_seconds_bucket[5m])) by (le, domain))",
          "legendFormat": "{{domain}} P95"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    }
  ],
  "schemaVersion": 39,
  "tags": ["yase", "search-engine"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "YASE Overview",
  "uid": "yase-overview"
}
